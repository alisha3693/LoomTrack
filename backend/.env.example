# Copy to backend/.env and fill in what you use. backend/.env is never committed.
# With nothing set, LoomTrack only records the messages it would send (see Sent messages in the office).

# Where buyers open the app (used for the links in messages).
LOOMTRACK_PUBLIC_URL=http://localhost:4000

# --- Email: any SMTP server (Gmail app password, Brevo free plan, or Mailpit on this machine) ---
# LOOMTRACK_SMTP_HOST=smtp.gmail.com
# LOOMTRACK_SMTP_PORT=587
# LOOMTRACK_SMTP_SECURITY=starttls        # starttls | ssl | none
# LOOMTRACK_SMTP_USER=orders@yourmill.example
# LOOMTRACK_SMTP_PASSWORD=
# LOOMTRACK_SMTP_FROM=LoomTrack <orders@yourmill.example>

# --- WhatsApp: Meta Cloud API (see docs/WHATSAPP_TEMPLATES.md) ---
# LOOMTRACK_WA_TOKEN=                      # permanent system-user token
# LOOMTRACK_WA_PHONE_ID=                   # Phone number ID
# LOOMTRACK_WA_LANGUAGE=en                 # the language the templates were approved in
# LOOMTRACK_WA_API_VERSION=v21.0
# LOOMTRACK_WA_VERIFY_TOKEN=               # any long random string; the same goes in Meta's webhook form
# LOOMTRACK_WA_APP_SECRET=                 # App settings > Basic; checks that webhook calls come from Meta
